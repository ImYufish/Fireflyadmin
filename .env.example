# Firefly 后台（/admin）环境变量模板
# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）。
# 部署到线上时，请把下面的变量填到平台的加密环境变量里，而不是提交本文件。

# ---------- GitHub OAuth App 登录（推荐）----------
# 在 https://github.com/settings/developers → New OAuth App 创建，
# Authorization callback URL 填 <站点地址>/api/admin/auth/callback/
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=

# ---------- 安全：登录白名单（强烈建议线上必填）----------
# 逗号分隔的 GitHub 用户名；留空 = 任何持有有效令牌的用户都能登录
ADMIN_GITHUB_USERS=

# ---------- 服务器访问 GitHub 的代理（直连可达时留空）----------
# 例如 Clash 默认 http://127.0.0.1:7890；未设置时自动读 HTTPS_PROXY / HTTP_PROXY
ADMIN_GITHUB_PROXY=

# ---------- 会话签名密钥 ----------
# 不设置时自动生成并保存到 .admin/session-secret；
# 部署到无持久文件系统的平台（如 Cloudflare Workers）时必须显式设置，
# 否则每次实例启动都会换密钥，导致已登录会话失效
ADMIN_SECRET=

# ---------- 线上 GitHub 模式（保存 = 提交 commit）----------
# 见 docs/admin.md；mode 可选 auto（默认）/ local / github
ADMIN_MODE=auto
ADMIN_GITHUB_REPO=
ADMIN_GITHUB_BRANCH=main
# 具有仓库 Contents 读写权限的 PAT
ADMIN_GITHUB_TOKEN=

# ---------- 仪表盘：Waline 评论 ----------
# 填管理员账号后走管理接口拉取全站评论；留空则按文章路径查询
ADMIN_WALINE_SERVER_URL=
ADMIN_WALINE_EMAIL=
ADMIN_WALINE_PASSWORD=

# ---------- 仪表盘：Umami 统计 ----------
ADMIN_UMAMI_URL=
ADMIN_UMAMI_USERNAME=
ADMIN_UMAMI_PASSWORD=
ADMIN_UMAMI_WEBSITE_ID=

# ---------- 图片管理：CloudFlare ImgBed（cfbed）图床 ----------
# token 需勾选 upload / list / delete 权限，imgbed_ 开头
ADMIN_IMGBED_URL=
ADMIN_IMGBED_TOKEN=

# ---------- 部署（SSR 模式才需要）----------
# 在线上启用后台路由；纯静态构建不需要，也不注入任何后台路由
ADMIN_ENABLE=
# Cloudflare Workers=true；Vercel=平台自动注入；EdgeOne Pages=1；通用 Node 服务器=EDGEONE_NODE=1
# CF_WORKERS=
# EDGEONE=
# EDGEONE_NODE=
