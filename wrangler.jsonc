{
	// Firefly 后台（/admin）是 SSR 路由，必须用 Cloudflare adapter 的产物部署。
	// 构建命令需带 CF_WORKERS=true ADMIN_ENABLE=true（见 package.json 的 build:cf）。
	"name": "fireflyadmin",
	"main": "@astrojs/cloudflare/entrypoints/server",
	// 2026-08-04 起 Workers 默认启用 nodejs_compat + nodejs_compat_v2。
	// 旧日期（2025-01-01）下许多 Node 模块缺失（undici 依赖的 node:net 等），SSR 会 500
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	// 后台登录会话存储（Astro Sessions API 自动使用；部署时自动 provision）
	"kv_namespaces": [
		{ "binding": "SESSION" }
	]
}
