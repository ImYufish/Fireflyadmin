---
import ImagesManager from "../components/ImagesManager.svelte";
import AdminLayout from "../layouts/AdminLayout.astro";
import { getSession } from "../lib/auth";

const session = getSession(Astro);
if (!session) return Astro.redirect("/admin/login/");
---

<AdminLayout title="图片管理" active="images" session={session}>
	<div class="mx-auto max-w-6xl p-6 md:p-8">
		<header class="mb-6">
			<h2 class="text-2xl font-bold text-(--admin-text-strong)">图片管理</h2>
			<p class="mt-1 text-sm text-(--admin-text)">
				上传、浏览与删除图片：默认存到项目 public/images/ 目录（线上模式自动提交到仓库），
				也可切换到 CloudFlare ImgBed（cfbed）图床；复制引用地址后即可在文章里使用。
			</p>
		</header>
		<ImagesManager client:load />
	</div>
</AdminLayout>
